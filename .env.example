# OpenAI-compatible providers; one key is enough. Paratera (Tsinghua) serves many models with one key;
# DeepSeek is the official DeepSeek API. The first provider with a key becomes the default.
PARATERA_API_KEY=
DEEPSEEK_API_KEY=
STEPFUN_API_KEY=
ZHIPU_API_KEY=

# REPRO_DEFAULT_PROVIDER=paratera
# REPRO_DEFAULT_MODEL=DeepSeek-V4-Flash
REPRO_MAX_COST_CNY=15
REPRO_MAX_WALL_MIN=60
REPRO_MAX_STEPS=120
REPRO_GLOBAL_CAP_CNY=600

# Required on a public server (the Docker image refuses to start without it): callers send it as X-Access-Key.
REPRO_ACCESS_KEY=
# REPRO_MAX_ACTIVE=2          # runs at the same time
# REPRO_CAP_COST_CNY=20       # per-run caps a caller cannot raise
# REPRO_CAP_MIN=90
